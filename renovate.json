{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Disable automatic updates for Meilisearch, Immich Valkey and LubeLogger Postgres",
      "matchUpdateTypes": [
        "major"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "getmeili/meilisearch",
        "docker.io/valkey/valkey",
        "docker.io/library/postgres"
      ],
      "enabled": false
    }
  ]
}
